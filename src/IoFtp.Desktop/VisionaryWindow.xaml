<Window x:Class="IoFtp.Desktop.VisionaryWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:local="clr-namespace:IoFtp.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="IRC Add-ons" Width="1150" Height="740" MinWidth="850" MinHeight="520"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
 <DockPanel Margin="14">
  <TextBlock DockPanel.Dock="Top" Text="IRC ADD-ONS" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
  <TabControl>
   <TabItem Header="IRC"><DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="12,6"><Button Content="Save IRC settings" Click="SaveIrc_Click"/><Button Content="RACE-Log" Click="RaceLog_Click"/></StackPanel>
    <local:IrcSettingsControl x:Name="IrcEditor"/>
   </DockPanel></TabItem>
   <TabItem Header="VISIONARY">
    <DockPanel Margin="12">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="VISIONARY · configuration and FluxFTP bridge" FontSize="20" Margin="0,0,0,10"/>
   <TextBlock Text="VISIONARY in mIRC remains responsible for trading, classification and rules. Save writes the selected configuration file and creates a backup; reload it in VISIONARY afterwards." TextWrapping="Wrap"/>
   <WrapPanel Margin="0,10">
    <Button Content="Import VISIONARY files…" Click="Import_Click"/>
    <Button Content="Import VISIONARY folder…" Click="Folder_Click"/>
    <Button Content="Import FTPRush…" Click="Rush_Click"/>
    <Button Content="Section paths…" Click="Sections_Click"/>

   </WrapPanel>

   <DockPanel Margin="0,0,0,6">
    <Button DockPanel.Dock="Right" Content="Choose rushopt.ini…" Click="ChooseRushOptions_Click"/>
    <TextBlock DockPanel.Dock="Left" Text="Sample / covers profiles" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <TextBox x:Name="RushOptionsBox" ToolTip="Blank uses built-in sample/covers profiles. Save race settings to apply to new races."/>
   </DockPanel>
   <TextBlock Text="FluxFTP race completion regex (NUKE / REASON always stop the race)"/>
   <TextBox x:Name="CompleteFlagBox" Margin="0,4"/>
   <WrapPanel Margin="0,0,0,8">
    <TextBlock Text="Rescan seconds" VerticalAlignment="Center"/><TextBox x:Name="RefreshBox" Width="45"/>
    <TextBlock Text="Timeout minutes" VerticalAlignment="Center"/><TextBox x:Name="TimeoutBox" Width="55"/>
    <Button Content="Save race settings" Click="SaveRace_Click"/>
    <Button Content="Use selected completeflag" Click="UseFlag_Click"/>
   </WrapPanel>
   <TextBox x:Name="HelpBox" IsReadOnly="True" TextWrapping="Wrap" Margin="0,0,0,10"/>
   <ComboBox x:Name="FilesBox" DisplayMemberPath="Path" SelectionChanged="File_Changed" Margin="0,0,0,8"/>
   <DockPanel Margin="0,0,0,8"><TextBlock Text="Filter section / setting / value" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBox x:Name="FilterBox" TextChanged="Filter_Changed"/></DockPanel>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom">
   <WrapPanel Margin="0,8"><Button Content="Save selected file + backup" Click="Save_Click"/><Button Content="Reload selected file" Click="Reload_Click"/><Button Content="Test selected completeflag…" Click="Test_Click"/></WrapPanel>
   <TextBlock x:Name="StatusText" TextWrapping="Wrap"/>
  </StackPanel>
  <DataGrid x:Name="EntriesGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
   <DataGrid.Columns>
    <DataGridTextColumn Header="SECTION" Binding="{Binding Section}" IsReadOnly="True" Width="180"/>
    <DataGridTextColumn Header="SETTING / REGEX" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="300"/>
    <DataGridTextColumn Header="VALUE (editable)" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
   </DataGrid.Columns>
  </DataGrid>
    </DockPanel>
   </TabItem>
   <TabItem Header="Bridge &amp; integrations"><StackPanel Margin="16">
    <TextBlock Text="mIRC and VISIONARY integration" FontSize="20" Margin="0,0,0,12"/>
    <CheckBox x:Name="BridgeBox" Content="Enable local VISIONARY bridge (same Windows account)" Checked="Bridge_Changed" Unchecked="Bridge_Changed" Margin="0,0,0,12"/>
    <TextBlock Text="Export the FluxFTP and VISIONARY mIRC scripts and DLLs, then load Visionary-FluxFTP.mrc after Visionary.mrc. Configuration and race rules are available in the VISIONARY tab." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12"/>
    <Button Content="Export mIRC bridge…" Click="ExportBridge_Click" HorizontalAlignment="Left"/>
   </StackPanel></TabItem>
  </TabControl>
 </DockPanel>
</Window>
