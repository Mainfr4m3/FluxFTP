<Window x:Class="IoFtp.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="FluxFTP" Width="1165" Height="750" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="MainWindow_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <DockPanel Background="{DynamicResource WindowBrush}">
        <Grid DockPanel.Dock="Top" Height="32" Background="{DynamicResource WindowBrush}">
            <Grid.Resources>
                <Style x:Key="CaptionButton" TargetType="Button">
                    <Setter Property="Width" Value="46"/>
                    <Setter Property="Height" Value="32"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                    <Setter Property="Template"><Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource BorderBrush}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value></Setter>
                </Style>
            </Grid.Resources>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Image Source="Assets/fluxftp-server-icon.png" Width="16" Height="16" Margin="0,0,6,0"/>
                <TextBlock Text="FluxFTP" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="TitleMessageText" Margin="150,0" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource CaptionButton}" Content="&#x2014;" ToolTip="Minimize" Click="CaptionMinimize_Click"/>
                <Button Style="{StaticResource CaptionButton}" Content="&#x25A1;" ToolTip="Maximize / Restore" Click="CaptionMaximize_Click"/>
                <Button Style="{StaticResource CaptionButton}" Content="&#x2715;" ToolTip="Close" Click="CaptionClose_Click"/>
            </StackPanel>
        </Grid>
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,3,0,0">
                    <TextBlock Text="Flux" Foreground="{DynamicResource AccentBrush}" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="FTP" FontSize="22" FontWeight="SemiBold" Margin="0,0,16,0" />
                </StackPanel>
                <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <WrapPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="VerticalAlignment" Value="Top"/>
                        </Style>
                    </WrapPanel.Resources>
                    <Button Content="Sites" Click="SiteManager_Click" />
                    <Button x:Name="ToolsButton" Content="Tools" Click="Tools_Click">
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom">
                                <MenuItem Header="IRC ADD-ONS" Click="Visionary_Click"/>
                                <MenuItem Header="SCRIPTS" Click="Scripts_Click"/>
                                <MenuItem Header="SECTIONS" Click="Sections_Click"/>
                                <MenuItem Header="SITE STATUS" Click="OpenSiteHealth_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="MetricsButton" Content="Metrics" Click="Metrics_Click" />
                    <Button x:Name="ManagerButton" Content="Manager" Click="ToggleManager_Click" />
                    <Button x:Name="ToggleQueueButton" Content="Queue" Click="ToggleQueue_Click" />
                    <Button x:Name="ToggleLogButton" Content="Log" Click="ToggleLog_Click" />
                    <Button Content="Global Settings" Click="GlobalSettings_Click" />
                    <Button Content="About" Click="About_Click" />
                    <TextBlock x:Name="ConnectionStatus" Text="Offline workspace" Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center" MaxWidth="240" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
                </WrapPanel>
            </Grid>
        </Border>

        <Border x:Name="LegendBar" DockPanel.Dock="Bottom" Height="34" Padding="0,2"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                SizeChanged="LegendBar_SizeChanged">
            <Grid ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="StaticStatusHost" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <TextBlock x:Name="StaticStatusText" TextWrapping="NoWrap" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                </ScrollViewer>
                <Canvas x:Name="ScrollingStatusHost" ClipToBounds="True" Visibility="Collapsed">
                    <TextBlock x:Name="ScrollingStatusText" TextWrapping="NoWrap" Foreground="{DynamicResource TextBrush}"/>
                </Canvas>
                <Grid x:Name="StaticStatusProgressPanel" Grid.Column="1" Width="140" Margin="12,0,4,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <ProgressBar Style="{StaticResource FilledProgressBar}" Height="18" Minimum="0" Maximum="100"
                                 Value="{Binding Value, ElementName=StatusProgressBar}" IsIndeterminate="{Binding IsIndeterminate, ElementName=StatusProgressBar}" Foreground="{Binding Foreground, ElementName=StatusProgressBar}"/>
                    <TextBlock Text="{Binding Text, ElementName=StatusProgressText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold"/>
                </Grid>
<Grid HorizontalAlignment="Stretch" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="120"/>
                    <ColumnDefinition Width="1"/><ColumnDefinition x:Name="TransferBytesColumn" Width="205"/>
                    <ColumnDefinition Width="1"/><ColumnDefinition x:Name="StatusProgressColumn" Width="150"/>
                    <ColumnDefinition Width="1"/><ColumnDefinition x:Name="ElapsedColumn" Width="125"/>
                    <ColumnDefinition Width="1"/><ColumnDefinition x:Name="RemainingColumn" Width="145"/>
                    <ColumnDefinition Width="1"/><ColumnDefinition x:Name="QueueTimeColumn" Width="115"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LegendText" Foreground="White" Text="FluxFTP ready" VerticalAlignment="Center" Margin="6,0"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <TextBlock x:Name="SessionStatusText" Grid.Row="1" Grid.ColumnSpan="11" Foreground="{DynamicResource TextBrush}" Margin="6,0"/>
                <Border x:Name="TransferBytesSeparator" Grid.Column="1" Background="{DynamicResource BorderBrush}" Margin="0,3"/>
                <TextBlock x:Name="TransferBytesText" Foreground="White" Grid.Column="2" Text="—" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <Border x:Name="ProgressSeparator" Grid.Column="3" Background="{DynamicResource BorderBrush}" Margin="0,3"/>
                <Grid x:Name="StatusProgressPanel" Grid.Column="4" Margin="7,4">
                    <ProgressBar x:Name="StatusProgressBar" Style="{StaticResource FilledProgressBar}" Height="18" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="StatusProgressText" Text="Idle" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="White"/>
                </Grid>
                <Border x:Name="ElapsedSeparator" Grid.Column="5" Background="{DynamicResource BorderBrush}" Margin="0,3"/>
                <TextBlock x:Name="ElapsedText" Foreground="White" Grid.Column="6" Text="Elapsed: —" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <Border x:Name="RemainingSeparator" Grid.Column="7" Background="{DynamicResource BorderBrush}" Margin="0,3"/>
                <TextBlock x:Name="RemainingText" Foreground="White" Grid.Column="8" Text="Remaining: —" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <Border x:Name="QueueTimeSeparator" Grid.Column="9" Background="{DynamicResource BorderBrush}" Margin="0,3"/>
                <TextBlock x:Name="QueueTimeText" Foreground="White" Grid.Column="10" Text="Queue: 00:00" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock x:Name="QueueStatus" Foreground="White" Text="0 queued" Visibility="Collapsed"/>
            </Grid>
            </Grid>
        </Border>

        <Grid x:Name="WorkspaceGrid" Background="{DynamicResource WindowBrush}">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ManagerRow" Height="*" />
                <RowDefinition Height="0" x:Name="QueueSplitterRow" />
                <RowDefinition Height="0" MinHeight="0" x:Name="QueueRow" />
                <RowDefinition x:Name="MetricsSplitterRow" Height="0"/>
                <RowDefinition x:Name="MetricsRow" Height="0"/>
                <RowDefinition x:Name="StatusSplitterRow" Height="0"/>
                <RowDefinition x:Name="StatusRow" Height="0"/>
                <RowDefinition Height="8" x:Name="LogSplitterRow" />
                <RowDefinition Height="150" MinHeight="70" x:Name="LogRow" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaneColumn" Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition x:Name="RightPaneColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource SurfaceBrush}" Margin="8,8,3,3"
                    Tag="Left" GotKeyboardFocus="CommandPane_GotKeyboardFocus" PreviewMouseDown="CommandPane_PreviewMouseDown"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="7,5,7,1">
                        <Button DockPanel.Dock="Right" Content="Transfer →" Click="Upload_Click" Padding="10,4"/>
                        <Button DockPanel.Dock="Right" Content="Commands" Click="CommandsLeft_Click" Padding="10,4"/>
                        <Button DockPanel.Dock="Right" Content="Bookmarks" Click="BookmarksLeft_Click" Padding="10,4"/>
                        <Button x:Name="LeftConnectionButton" DockPanel.Dock="Right" Content="Connect" Click="ToggleConnection_Click" Tag="Left" MinWidth="95" Padding="10,4"/>
                        <ComboBox x:Name="LeftQuickSites" DockPanel.Dock="Right" Width="145" Margin="3"
                                  DisplayMemberPath="Label" SelectionChanged="LeftQuickSites_SelectionChanged"
                                  DropDownOpened="QuickSites_DropDownOpened" ToolTip="Quick Connect from saved sites"/>
                        <ComboBox x:Name="LeftMode" SelectionChanged="LeftMode_Changed" Width="105" Margin="3"><ComboBoxItem Content="Local"/><ComboBoxItem Content="Remote" IsSelected="True"/></ComboBox>
                        <TextBlock x:Name="LeftSiteTitle" Text="REMOTE SITE" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="6,3" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border x:Name="LeftDriveBarBorder" DockPanel.Dock="Top" Visibility="Collapsed"
                            Margin="8,3,8,2" Padding="4,3" Background="{DynamicResource WindowBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="New folder" Click="CreateFolderLeft_Click" Padding="8,3" Margin="3,0,0,0" ToolTip="Create a new folder"/>
                                <Button Content="Rename" Click="RenameLeft_Click" Padding="8,3" Margin="3,0,0,0" ToolTip="Rename selected item"/>
                                <Button Content="Delete" Click="DeleteLeft_Click" Padding="8,3" Margin="3,0,0,0" ToolTip="Delete selected items"/>
                                <Button Content="Refresh" Click="RefreshLeft_Click" Padding="8,3" Margin="3,0,0,0" ToolTip="Refresh (F5)"/>
                            </StackPanel>
                            <StackPanel x:Name="LeftDriveBar" Orientation="Horizontal"/>
                        </DockPanel>
                    </Border>
                    <DockPanel DockPanel.Dock="Top" Margin="8,2,8,8">
                        <Button DockPanel.Dock="Right" Content="Up" Click="LocalUp_Click" Margin="5,0,0,0" Padding="10,4"/>
                        <ComboBox x:Name="LeftBookmarks" DockPanel.Dock="Right" Width="150" Margin="5,0,0,0"
                                  DisplayMemberPath="Name" SelectionChanged="LeftBookmarks_SelectionChanged" ToolTip="Imported FTPRush bookmarks"/>
                        <ComboBox x:Name="LeftDrives" DockPanel.Dock="Left" Width="82" Margin="0,0,5,0"
                                  Visibility="Collapsed" SelectionChanged="LeftDrives_SelectionChanged"
                                  ToolTip="Select local drive"/>
                        <Button DockPanel.Dock="Left" Content="&#x25C0;" Click="LeftBack_Click" Width="32" Margin="0,0,3,0" ToolTip="Back"/>
                        <Button DockPanel.Dock="Left" Content="&#x25B6;" Click="LeftForward_Click" Width="32" Margin="0,0,3,0" ToolTip="Forward"/>
                        <Button DockPanel.Dock="Left" Content="&#x21BB;" Click="RefreshLeft_Click" Width="32" Margin="0,0,5,0" ToolTip="Refresh (F5)"/>
                        <ComboBox x:Name="LocalPath" IsEditable="True" IsTextSearchEnabled="False" Text="/"
                                  KeyDown="LocalPath_KeyDown" DropDownOpened="Path_DropDownOpened"
                                  DropDownClosed="LocalPath_DropDownClosed" ToolTip="Path history and common locations"/>
                    </DockPanel>
                    <ListView x:Name="LocalList" Margin="8,0,8,8" SelectionMode="Extended" PreviewKeyDown="FileList_PreviewKeyDown" MouseDoubleClick="LocalList_DoubleClick" SizeChanged="FileList_SizeChanged"
                              PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="FileList_PreviewMouseLeftButtonUp"
                              MouseMove="LocalList_MouseMove"
                              PreviewMouseRightButtonDown="FileList_PreviewMouseRightButtonDown" AllowDrop="True"
                              PreviewDragOver="FileList_DragOver" Drop="LocalList_Drop">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                            <Style.Triggers><DataTrigger Binding="{Binding IsNuked}" Value="True"><Setter Property="Foreground" Value="#F07178"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                            </Style.Triggers>
                        </Style></ListView.ItemContainerStyle>
                        <ListView.ContextMenu><ContextMenu>
                            <MenuItem Header="Transfer now →" Click="TransferLeftNow_Click"/><MenuItem Header="Add to queue →" Click="QueueLeft_Click"/><Separator/>
                            <MenuItem Header="View internally" Click="ViewInternalLeft_Click"/>
                            <MenuItem Header="Open externally" Click="ViewLeft_Click"/>
                            <MenuItem Header="Create folder..." Click="CreateFolderLeft_Click"/><MenuItem Header="Create folder and enter..." Click="CreateFolderAndEnterLeft_Click"/><MenuItem Header="Create empty file..." Click="CreateFileLeft_Click"/>
                            <Separator/><MenuItem Header="Rename..." Click="RenameLeft_Click"/><MenuItem Header="Delete" Click="DeleteLeft_Click" InputGestureText="Del"/><MenuItem Header="Attributes / CHMOD..." Click="ChmodLeft_Click"/><Separator/>
                            <MenuItem Header="Copy name" Click="CopyNameLeft_Click"/><MenuItem Header="Copy full path" Click="CopyPathLeft_Click"/><MenuItem Header="Copy FTP URL" Click="CopyUrlLeft_Click"/><MenuItem Header="Commands..." Click="CommandsLeft_Click"/><Separator/><MenuItem Header="Refresh" Click="RefreshLeft_Click" InputGestureText="F5"/>
                        </ContextMenu></ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn x:Name="LeftNameColumn" DisplayMemberBinding="{Binding Name}" Width="270"><GridViewColumn.Header><GridViewColumnHeader x:Name="LeftNameHeader" Content="Name" Tag="Name" Click="LeftHeader_Click"/></GridViewColumn.Header></GridViewColumn>
                                <GridViewColumn DisplayMemberBinding="{Binding Size}" Width="90"><GridViewColumn.Header><GridViewColumnHeader x:Name="LeftSizeHeader" Content="Size" Tag="SortSize" Click="LeftHeader_Click"/></GridViewColumn.Header></GridViewColumn>
                                <GridViewColumn DisplayMemberBinding="{Binding Modified}" Width="150"><GridViewColumn.Header><GridViewColumnHeader x:Name="LeftModifiedHeader" Content="Modified" Tag="SortModified" Click="LeftHeader_Click"/></GridViewColumn.Header></GridViewColumn>
                                <GridViewColumn Header="Attributes" DisplayMemberBinding="{Binding Attributes}" Width="110" />
                                <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="150" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Row="0" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" />

            <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource SurfaceBrush}" Margin="3,8,8,3"
                    Tag="Right" GotKeyboardFocus="CommandPane_GotKeyboardFocus" PreviewMouseDown="CommandPane_PreviewMouseDown"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="7,5,7,1">
                        <Button DockPanel.Dock="Right" Content="← Transfer" Click="Download_Click" Padding="10,4"/>
                        <Button DockPanel.Dock="Right" Content="Commands" Click="CommandsRight_Click" Padding="10,4"/>
                        <Button DockPanel.Dock="Right" Content="Bookmarks" Click="BookmarksRight_Click" Padding="10,4"/>
                        <Button x:Name="RightConnectionButton" DockPanel.Dock="Right" Content="Connect" Click="ToggleConnection_Click" Tag="Right" MinWidth="95" Padding="10,4"/>
                        <ComboBox x:Name="RightQuickSites" DockPanel.Dock="Right" Width="145" Margin="3"
                                  DisplayMemberPath="Label" SelectionChanged="RightQuickSites_SelectionChanged"
                                  DropDownOpened="QuickSites_DropDownOpened" ToolTip="Quick Connect from saved sites"/>
                        <ComboBox x:Name="RightMode" SelectionChanged="RightMode_Changed" Width="105" Margin="3"><ComboBoxItem Content="Local"/><ComboBoxItem Content="Remote" IsSelected="True"/></ComboBox>
                        <TextBlock x:Name="RemoteSiteTitle" Text="REMOTE SITE" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="3" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border x:Name="RightDriveBarBorder" DockPanel.Dock="Top" Visibility="Collapsed"
                            Margin="8,3,8,2" Padding="4,3" Background="{DynamicResource WindowBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="New folder" Click="CreateFolderRight_Click" Padding="8,3" Margin="3,0,0,0" ToolTip="Create a new folder"/>
                                <Button Content="Rename" Click="RenameRight_Click" Padding="8,3" Margin="3,0,0,0" ToolTip="Rename selected item"/>
                                <Button Content="Delete" Click="DeleteRight_Click" Padding="8,3" Margin="3,0,0,0" ToolTip="Delete selected items"/>
                                <Button Content="Refresh" Click="RefreshRight_Click" Padding="8,3" Margin="3,0,0,0" ToolTip="Refresh (F5)"/>
                            </StackPanel>
                            <StackPanel x:Name="RightDriveBar" Orientation="Horizontal"/>
                        </DockPanel>
                    </Border>
                    <DockPanel DockPanel.Dock="Top" Margin="8,2,8,8">
                        <Button DockPanel.Dock="Right" Content="Up" Click="RemoteUp_Click" Margin="5,0,0,0" Padding="10,4"/>
                        <ComboBox x:Name="RightBookmarks" DockPanel.Dock="Right" Width="150" Margin="5,0,0,0"
                                  DisplayMemberPath="Name" SelectionChanged="RightBookmarks_SelectionChanged" ToolTip="Imported FTPRush bookmarks"/>
                        <ComboBox x:Name="RightDrives" DockPanel.Dock="Left" Width="82" Margin="0,0,5,0"
                                  Visibility="Collapsed" SelectionChanged="RightDrives_SelectionChanged"
                                  ToolTip="Select local drive"/>
                        <Button DockPanel.Dock="Left" Content="&#x25C0;" Click="RightBack_Click" Width="32" Margin="0,0,3,0" ToolTip="Back"/>
                        <Button DockPanel.Dock="Left" Content="&#x25B6;" Click="RightForward_Click" Width="32" Margin="0,0,3,0" ToolTip="Forward"/>
                        <Button DockPanel.Dock="Left" Content="&#x21BB;" Click="RefreshRight_Click" Width="32" Margin="0,0,5,0" ToolTip="Refresh (F5)"/>
                        <ComboBox x:Name="RemotePath" IsEditable="True" IsTextSearchEnabled="False" Text="/"
                                  KeyDown="RemotePath_KeyDown" DropDownOpened="Path_DropDownOpened"
                                  DropDownClosed="RemotePath_DropDownClosed" ToolTip="Path history and common locations"/>
                    </DockPanel>
                    <ListView x:Name="RemoteList" Margin="8,0,8,8" SelectionMode="Extended" PreviewKeyDown="FileList_PreviewKeyDown" MouseDoubleClick="RemoteList_DoubleClick" SizeChanged="FileList_SizeChanged"
                              PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="FileList_PreviewMouseLeftButtonUp"
                              MouseMove="RemoteList_MouseMove"
                              PreviewMouseRightButtonDown="FileList_PreviewMouseRightButtonDown" AllowDrop="True"
                              PreviewDragOver="FileList_DragOver" Drop="RemoteList_Drop">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                            <Style.Triggers><DataTrigger Binding="{Binding IsNuked}" Value="True"><Setter Property="Foreground" Value="#F07178"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                            </Style.Triggers>
                        </Style></ListView.ItemContainerStyle>
                        <ListView.ContextMenu><ContextMenu>
                            <MenuItem Header="← Transfer now" Click="TransferRightNow_Click"/><MenuItem Header="← Add to queue" Click="QueueRight_Click"/><Separator/>
                            <MenuItem Header="View internally" Click="ViewInternalRight_Click"/>
                            <MenuItem Header="Open externally" Click="ViewRight_Click"/>
                            <MenuItem Header="Create folder..." Click="CreateFolderRight_Click"/><MenuItem Header="Create folder and enter..." Click="CreateFolderAndEnterRight_Click"/><MenuItem Header="Create empty file..." Click="CreateFileRight_Click"/>
                            <Separator/><MenuItem Header="Rename..." Click="RenameRight_Click"/><MenuItem Header="Delete" Click="DeleteRight_Click" InputGestureText="Del"/><MenuItem Header="Attributes / CHMOD..." Click="ChmodRight_Click"/><Separator/>
                            <MenuItem Header="Copy name" Click="CopyNameRight_Click"/><MenuItem Header="Copy full path" Click="CopyPathRight_Click"/><MenuItem Header="Copy FTP URL" Click="CopyUrlRight_Click"/><MenuItem Header="Commands..." Click="CommandsRight_Click"/><Separator/><MenuItem Header="Refresh" Click="RefreshRight_Click" InputGestureText="F5"/>
                        </ContextMenu></ListView.ContextMenu>
                        <ListView.View><GridView>
                            <GridViewColumn x:Name="RightNameColumn" DisplayMemberBinding="{Binding Name}" Width="270"><GridViewColumn.Header><GridViewColumnHeader x:Name="RightNameHeader" Content="Name" Tag="Name" Click="RightHeader_Click"/></GridViewColumn.Header></GridViewColumn>
                            <GridViewColumn DisplayMemberBinding="{Binding DisplaySize}" Width="90"><GridViewColumn.Header><GridViewColumnHeader x:Name="RightSizeHeader" Content="Size" Tag="SortSize" Click="RightHeader_Click"/></GridViewColumn.Header></GridViewColumn>
                            <GridViewColumn DisplayMemberBinding="{Binding DisplayModified}" Width="150"><GridViewColumn.Header><GridViewColumnHeader x:Name="RightModifiedHeader" Content="Modified" Tag="SortModified" Click="RightHeader_Click"/></GridViewColumn.Header></GridViewColumn>
                            <GridViewColumn Header="Attributes" DisplayMemberBinding="{Binding Attributes}" Width="110"/>
                            <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="150"/>
                        </GridView></ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

            <primitives:Thumb x:Name="QueueSplitter" Grid.Row="1" Grid.ColumnSpan="3" Height="8"
                              Cursor="SizeNS" DragDelta="QueueSplitter_DragDelta"
                              ToolTip="Drag to resize the transfer queue" Visibility="Collapsed">
                <primitives:Thumb.Template><ControlTemplate TargetType="{x:Type primitives:Thumb}">
                    <Grid Background="Transparent"><Border Height="2" Margin="80,0" VerticalAlignment="Center"
                                                          Background="{DynamicResource BorderBrush}" CornerRadius="1"/></Grid>
                </ControlTemplate></primitives:Thumb.Template>
            </primitives:Thumb>

            <Border x:Name="QueuePanel" Grid.Row="2" Grid.ColumnSpan="3" Background="{DynamicResource SurfaceBrush}" Margin="8,3"
                    Visibility="Collapsed"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="7,4">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Start queue" Click="StartQueue_Click" Padding="9,3"/>
                            <Button Content="Stop queue" Click="StopQueue_Click" Padding="9,3"/>
                            <Button Content="Pause selected" Click="PauseTransfer_Click" Padding="9,3"/>
                            <Button Content="Resume selected" Click="ResumeTransfer_Click" Padding="9,3"/>
                            <Button Content="Clear finished" Click="ClearFinished_Click" Padding="9,3"/>
                            <Button Content="Clear all" Click="ClearAll_Click" Padding="9,3"/>
                        </StackPanel>
                        <TextBlock Text="TRANSFER QUEUE" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" Margin="3" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListView x:Name="QueueList" SizeChanged="QueueList_SizeChanged"
                              PreviewMouseRightButtonDown="FileList_PreviewMouseRightButtonDown"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Start queue" Click="StartQueue_Click"/>
                                <MenuItem Header="Stop queue" Click="StopQueue_Click"/>
                                <Separator/>
                                <MenuItem Header="Resume selected" Click="ResumeTransfer_Click"/>
                                <MenuItem Header="Remove selected" Click="RemoveQueueJob_Click"/>
                                <Separator/>
                                <MenuItem Header="Move up" Tag="Up" Click="MoveQueueJobs_Click"/>
                                <MenuItem Header="Move down" Tag="Down" Click="MoveQueueJobs_Click"/>
                                <MenuItem Header="Move to top" Tag="Top" Click="MoveQueueJobs_Click"/>
                                <MenuItem Header="Move to bottom" Tag="Bottom" Click="MoveQueueJobs_Click"/>

                                <Separator/>
                                <MenuItem Header="Reset failed jobs" Click="ResetFailedQueueJobs_Click" ToolTip="Retry eligible saved connection/timeout failures with fresh sessions; cooldown and retry limits apply."/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn x:Name="QueueStateColumn" DisplayMemberBinding="{Binding State}" Width="82"><GridViewColumn.Header><GridViewColumnHeader x:Name="QueueStateHeader" Content="State" Tag="State" Click="QueueHeader_Click"/></GridViewColumn.Header></GridViewColumn>
                                <GridViewColumn x:Name="QueueNameColumn" DisplayMemberBinding="{Binding Name}" Width="240"><GridViewColumn.Header><GridViewColumnHeader x:Name="QueueNameHeader" Content="Name" Tag="Name" Click="QueueHeader_Click"/></GridViewColumn.Header></GridViewColumn>
                                <GridViewColumn x:Name="QueueSourceColumn" DisplayMemberBinding="{Binding Source}" Width="220"><GridViewColumn.Header><GridViewColumnHeader x:Name="QueueSourceHeader" Content="Source" Tag="Source" Click="QueueHeader_Click"/></GridViewColumn.Header></GridViewColumn>
                                <GridViewColumn x:Name="QueueDestinationColumn" DisplayMemberBinding="{Binding Destination}" Width="220"><GridViewColumn.Header><GridViewColumnHeader x:Name="QueueDestinationHeader" Content="Destination" Tag="Destination" Click="QueueHeader_Click"/></GridViewColumn.Header></GridViewColumn>
                                <GridViewColumn x:Name="QueueProgressColumn" Width="210"><GridViewColumn.Header><GridViewColumnHeader x:Name="QueueProgressHeader" Content="Progress" Tag="ProgressPercent" Click="QueueHeader_Click"/></GridViewColumn.Header><GridViewColumn.CellTemplate><DataTemplate>
                                    <Grid Margin="3,2"><ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" Height="18" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="{Binding ProgressDisplay}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                    </Grid>
                                </DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

            <primitives:Thumb x:Name="LogSplitter" Grid.Row="7" Grid.ColumnSpan="3" Height="8"
                              Cursor="SizeNS" DragDelta="LogSplitter_DragDelta"
                              ToolTip="Drag to resize the connection log">
                <primitives:Thumb.Template><ControlTemplate TargetType="{x:Type primitives:Thumb}">
                    <Grid Background="Transparent"><Border Height="2" Margin="80,0" VerticalAlignment="Center"
                                                          Background="{DynamicResource BorderBrush}" CornerRadius="1"/></Grid>
                </ControlTemplate></primitives:Thumb.Template>
            </primitives:Thumb>

            <Border x:Name="LogPanel" Grid.Row="8" Grid.ColumnSpan="3" Background="{DynamicResource WindowBrush}" Margin="8,3,8,8"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                <TabControl x:Name="LogTabs" SelectionChanged="LogTabs_SelectionChanged" Background="{DynamicResource WindowBrush}" BorderThickness="0">
                    <TabItem Header="FTP-LOG">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="10,4">
                        <TextBlock Text="CONNECTION LOG · FTP COMMANDS AND SERVER REPLIES" Foreground="{DynamicResource MutedTextBrush}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Copy" Padding="8,2" Margin="3,0" Click="CopyLog_Click" />
                            <Button Content="Clear" Padding="8,2" Margin="3,0" Click="ClearLog_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="LogText" IsReadOnly="True" AcceptsReturn="True" BorderThickness="0"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"
                             FontFamily="{DynamicResource AppMonospaceFontFamily}" />
                </DockPanel>
                    </TabItem>
                    <TabItem x:Name="CommandsLogTab" Header="COMMANDS"><ContentControl x:Name="CommandsLogHost"/></TabItem>
                    <TabItem x:Name="BridgeInfoTab" Header="BRIDGE-INFO"><ContentControl x:Name="BridgeInfoHost"/></TabItem>
                    <TabItem x:Name="RaceLogTab" Header="RACE-LOG"><ContentControl x:Name="RaceLogHost"/></TabItem>
                    <TabItem x:Name="SpreadJobsTab" Header="SPREAD-JOBS"><ContentControl x:Name="SpreadJobsHost"/></TabItem>
                    <TabItem x:Name="TransferJobsTab" Header="TRANSFER-JOBS"><ContentControl x:Name="TransferJobsHost"/></TabItem>
                </TabControl>
            </Border>
            <primitives:Thumb x:Name="MetricsSplitter" Grid.Row="3" Grid.ColumnSpan="3" Height="6" HorizontalAlignment="Stretch" Cursor="SizeNS" DragDelta="PanelSplitter_DragDelta" Visibility="Collapsed" Background="Transparent"><primitives:Thumb.Template><ControlTemplate TargetType="{x:Type primitives:Thumb}"><Grid Background="Transparent"><Border Height="2" Margin="80,0" VerticalAlignment="Center" Background="{DynamicResource BorderBrush}" CornerRadius="1"/></Grid></ControlTemplate></primitives:Thumb.Template></primitives:Thumb>
            <ContentControl x:Name="MetricsHost" Grid.Row="4" Grid.ColumnSpan="3" Visibility="Collapsed"/>
            <primitives:Thumb x:Name="StatusSplitter" Grid.Row="5" Grid.ColumnSpan="3" Height="6" HorizontalAlignment="Stretch" Cursor="SizeNS" DragDelta="PanelSplitter_DragDelta" Visibility="Collapsed" Background="Transparent"><primitives:Thumb.Template><ControlTemplate TargetType="{x:Type primitives:Thumb}"><Grid Background="Transparent"><Border Height="2" Margin="80,0" VerticalAlignment="Center" Background="{DynamicResource BorderBrush}" CornerRadius="1"/></Grid></ControlTemplate></primitives:Thumb.Template></primitives:Thumb>
            <ContentControl x:Name="StatusHost" Grid.Row="6" Grid.ColumnSpan="3" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</Window>

