<Window x:Class="IoFtp.Desktop.SiteManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Site Manager" Width="1180" Height="520" MinWidth="900" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="16" Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Test All Sites" Click="TestAllSites_Click" HorizontalAlignment="Right"/><TextBlock Text="Saved sites" FontSize="22" FontWeight="SemiBold"/></DockPanel>
        <ListView x:Name="SitesList" Grid.Row="1" MouseDoubleClick="Edit_Click" GridViewColumnHeader.Click="SortSites_Click">
            <ListView.View><GridView>
                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="130"/>
                <GridViewColumn Header="Slots" DisplayMemberBinding="{Binding EffectiveOptions.MaxSlots}" Width="55"/>
                <GridViewColumn Header="Up" DisplayMemberBinding="{Binding EffectiveOptions.MaxUploadSlots}" Width="45"/>
                <GridViewColumn Header="Down" DisplayMemberBinding="{Binding EffectiveOptions.MaxDownloadSlots}" Width="55"/>
                <GridViewColumn Header="Prio" DisplayMemberBinding="{Binding EffectiveOptions.Priority}" Width="55"/>
                <GridViewColumn Header="Link speed" DisplayMemberBinding="{Binding LinkSpeedDisplay}" Width="105"/>
                <GridViewColumn Header="Description" DisplayMemberBinding="{Binding Description}" Width="140"/>
                <GridViewColumn Header="Protocol" DisplayMemberBinding="{Binding ProtocolDisplay}" Width="100"/>
                <GridViewColumn Header="Host" DisplayMemberBinding="{Binding Host}" Width="170"/>
                <GridViewColumn Header="Port" DisplayMemberBinding="{Binding Port}" Width="70"/>
                <GridViewColumn Header="Listing" DisplayMemberBinding="{Binding ListingMode}" Width="100"/>
            </GridView></ListView.View>
        </ListView>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal"><Button Content="New" Click="New_Click"/><Button Content="Edit" Click="Edit_Click"/><Button Content="Site Options" Click="Options_Click"/><Button Content="Delete" Click="Delete_Click"/><Button Content="Import FTPRush" Click="ImportFtpRush_Click"/><Button Content="Import FlashFXP" Click="ImportFlashFxp_Click"/></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Close" IsCancel="True"/><Button Content="Connect" Click="Connect_Click" IsDefault="True"/></StackPanel>
        </Grid>
    </Grid>
</Window>
