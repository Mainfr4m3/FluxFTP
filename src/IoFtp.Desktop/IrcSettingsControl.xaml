<UserControl x:Class="IoFtp.Desktop.IrcSettingsControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><DockPanel><TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" Foreground="#F07178" TextWrapping="Wrap" Margin="16,4"/><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
                        <CheckBox x:Name="IrcEnabledBox" Content="Connect to IRC when FluxFTP starts" Margin="0,0,0,10"/>
                        <TextBlock Text="IRC server / ZNC host"/><TextBox x:Name="IrcHostBox" Margin="0,4,0,8"/>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="Port" VerticalAlignment="Center"/><TextBox x:Name="IrcPortBox" Width="85" Margin="12,0"/><CheckBox x:Name="IrcTlsBox" Content="TLS" VerticalAlignment="Center"/></StackPanel>
                        <CheckBox x:Name="IrcAllowInvalidCertificateBox" Content="Accept invalid / self-signed certificates" Margin="0,8" IsEnabled="{Binding IsChecked, ElementName=IrcTlsBox}" ToolTip="Keeps TLS encryption but skips server certificate validation for this IRC/ZNC connection."/>
                        <TextBlock Text="Network name (used by IRC commands)"/><TextBox x:Name="IrcNetworkNameBox" Margin="0,4,0,8"/>
                        <TextBlock Text="Nickname" Margin="0,10,0,0"/><TextBox x:Name="IrcNickBox" Margin="0,4,0,8"/>
                        <CheckBox x:Name="IrcZncBox" Content="Connect through ZNC" Margin="0,4"/>
                        <TextBlock Text="ZNC username / network"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="IrcZncUserBox" Margin="0,4,6,8" ToolTip="ZNC username"/><TextBox x:Name="IrcZncNetworkBox" Grid.Column="1" Margin="6,4,0,8" ToolTip="ZNC network name"/></Grid>
                        <TextBlock Text="Server password / ZNC password"/><PasswordBox x:Name="IrcPasswordBox" Margin="0,4,0,8" Padding="8,5"/>
                        <TextBlock Text="Channel (FluxFTP needs @ here)"/><TextBox x:Name="IrcChannelBox" Margin="0,4,0,8"/>
                        <TextBlock Text="FTP site used to verify admins (ioFTPD flags 1 or M)"/><ComboBox x:Name="IrcSiteBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,4,0,8"/>
                        <TextBlock Text="Choose a site using FTPS with a valid certificate. Its saved account must be able to run SITE USER for other users." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="IrcLoginBox" Content="Allow private !login &lt;FTP-user&gt; &lt;password&gt; (requires TLS)" Margin="0,4"/>
                        <TextBlock Text="Private messages pass through your IRC server and ZNC; their logging settings apply. FluxFTP does not log or save these passwords." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,8"/>
                        <TextBlock Text="Saved account links — one IRC-account=FTP-user per line"/><TextBox x:Name="IrcLinksBox" AcceptsReturn="True" Height="105" VerticalScrollBarVisibility="Auto" Margin="0,4,0,8"/>
                        <TextBlock Text="Use the registered account name, not the nickname. Identify with NickServ, then !op. Linked admins also receive an @ request on joining when extended-join is supported." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBox x:Name="IrcNewsPathBox" Visibility="Collapsed"/>
                        <TextBlock Text="Commands: !help, !op, private !login, !news, !announces, !logout. !news shows FluxFTP project releases in the requesting channel or private conversation. Saving reconnects IRC; connection status appears in the main log." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel></ScrollViewer></DockPanel></UserControl>