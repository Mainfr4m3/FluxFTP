<Window x:Class="IoFtp.Desktop.GlobalSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Global Settings" Width="720" Height="680" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources><Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="FontWeight" Value="Normal"/><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="FontWeight" Value="Bold"/></Trigger></Style.Triggers></Style></Window.Resources>
    <DockPanel Margin="18" Background="{DynamicResource WindowBrush}">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Cancel" IsCancel="True"/><Button Content="Save" IsDefault="True" Click="Save_Click"/></StackPanel>
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="GLOBAL SETTINGS" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
            <TextBlock DockPanel.Dock="Bottom" x:Name="ErrorText" Foreground="#F07178" Margin="0,8" TextWrapping="Wrap"/>
            <TabControl>
                <TabItem Header="Network"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Bind address/interface"/><TextBox x:Name="BindBox" Grid.Column="1" Margin="0,4" ToolTip="Blank means Windows chooses the interface."/>
                    <TextBlock Grid.Row="1" Text="Active port range from"/><TextBox x:Name="PortFromBox" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
                    <TextBlock Grid.Row="2" Text="Active port range to"/><TextBox x:Name="PortToBox" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
                    <TextBlock Grid.Row="3" Text="Allowed passive ports from"/><TextBox x:Name="PassiveFromBox" Grid.Row="3" Grid.Column="1" Margin="0,4" ToolTip="Blank allows all server ports. Checks PASV/EPSV/CPSV for every site; does not choose the server port."/>
                    <TextBlock Grid.Row="4" Text="Allowed passive ports to"/><TextBox x:Name="PassiveToBox" Grid.Row="4" Grid.Column="1" Margin="0,4"/>
                    <CheckBox x:Name="ApiEnabledBox" Grid.Row="5" Grid.ColumnSpan="2" Content="Enable HTTPS/JSON API" Margin="0,10,0,4"/>
                    <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal"><TextBlock Text="API port" Width="220"/><TextBox x:Name="ApiPortBox" Width="100"/><CheckBox x:Name="ApiLocalBox" Content="Localhost only" Margin="18,0"/></StackPanel>
                    <TextBlock Grid.Row="7" Text="API password" VerticalAlignment="Center"/><PasswordBox x:Name="ApiPasswordBox" Grid.Row="7" Grid.Column="1" Margin="0,4" Padding="8,5"/>
                </Grid></TabItem>
                <TabItem Header="Jobs &amp; history"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="Transfer job history"/><TextBox x:Name="JobHistoryBox" Grid.Row="0" Grid.Column="1" Margin="0,4"/><TextBlock Grid.Row="1" Text="Transfer history"/><TextBox x:Name="TransferHistoryBox" Grid.Row="1" Grid.Column="1" Margin="0,4"/><TextBlock Grid.Row="2" Text="Log buffer history"/><TextBox x:Name="LogHistoryBox" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
                <Button Content="Advanced…" Click="JobsAdvanced_Click" Grid.Row="3" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="0,14,0,6" x:Name="JobsAdvancedButton"/><Grid x:Name="JobsAdvancedPanel" Visibility="Collapsed" Grid.Row="4" Grid.ColumnSpan="2"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Prepared job expiration (seconds)" Grid.Row="0"/><TextBox x:Name="ExpirationBox" Grid.Column="1" Margin="0,4" Grid.Row="0"/><TextBlock Grid.Row="1" Text="Starter timeout (seconds)"/><TextBox x:Name="StarterBox" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
                    <TextBlock Grid.Row="2" Text="Max transfer runtime (minutes, 0 unlimited)"/><TextBox x:Name="RuntimeBox" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
                    <CheckBox x:Name="AutoHardResetBox" Grid.Row="3" Grid.ColumnSpan="2" Content="Automatic hard reset (failed / timed-out jobs)" Margin="0,16,0,8" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Grid.Row="4" Text="Hard reset cooldown (seconds)"/><TextBox x:Name="HardResetCooldownBox" Grid.Row="4" Grid.Column="1" Margin="0,4"/>
                    <TextBlock Grid.Row="5" Text="Maximum hard reset retries"/><TextBox x:Name="HardResetRetriesBox" Grid.Row="5" Grid.Column="1" Margin="0,4"/>
                    <TextBlock Grid.Row="6" Text="Hard reset lookback (minutes)"/><TextBox x:Name="HardResetLookbackBox" Grid.Row="6" Grid.Column="1" Margin="0,4"/>
                    <TextBlock Grid.Row="7" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0" Text="Manual controls: Transfer Jobs. Connection/timeout failures only, with fresh sessions and existing TLS/target policies. Excludes paused jobs, expired races, DUPE, locks and CRC errors. Session-only history."/>
                <TextBlock Grid.Row="8" Text="Maximum active spread jobs" Margin="0,14,0,4"/><TextBox x:Name="MaxSpreadJobsBox" Grid.Row="8" Grid.Column="1" Margin="0,14,0,4" ToolTip="1–2048; default 32. Applies to HTTPS /spreadjobs. Site transfer slots still apply."/>
<TextBlock Grid.Row="9" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" Text="HTTPS spread jobs only; Visionary chains use a separate watch queue. Site upload/download limits still apply. Saving updates limits without stopping active transfers or races. API connection changes apply after restarting FluxFTP."/><TextBlock Grid.Row="10" Text="Visionary concurrent scheduling" Margin="0,14,0,4"/><TextBox x:Name="VisionarySchedulingBox" Grid.Row="10" Grid.Column="1" Margin="0,14,0,4" ToolTip="1–2048; default 32. Concurrent inventory/scheduling steps, not FTP connections or total watches."/>
<TextBlock Grid.Row="11" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" Text="Waiting watches release their scheduling slot. Site upload/download limits still apply. Changes apply without stopping active watches. Lower limits take effect as current scheduling steps finish."/><TextBlock Grid.Row="12" Text="Race recheck interval (seconds)" Margin="0,14,0,4"/><TextBox x:Name="VisionaryRecheckBox" Grid.Row="12" Grid.Column="1" Margin="0,14,0,4" ToolTip="1–60 seconds. Incoming Visi updates still wake immediately. Active watches use the new polling interval; in-progress steps keep their current retry policy."/><TextBlock Grid.Row="13" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" Text="Choose 1 second for faster idle rechecks. This increases FTP listing traffic; site login/transfer limits and the separate maximum race lifetime still apply."/></Grid></Grid></ScrollViewer></TabItem>
                <TabItem Header="Status commands"><StackPanel Margin="16">
                    <TextBlock Text="Status command"/>
                    <TextBox x:Name="StatusCommandBox" Margin="0,4,0,12" ToolTip="Default: SITE WKUP 50"/>
                    <TextBlock Text="Interval (minutes)"/>
                    <TextBox x:Name="StatusCommandIntervalBox" Margin="0,4,0,12" ToolTip="1–10080 minutes; default 60 (once per hour per site)."/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Text="The command and its reply appear in COMMANDS. Uses an idle shared server session; busy or disconnected sites wait until a session is available. The first request runs when a session is available, then repeats at this interval. Changes apply after saving."/>
                </StackPanel></TabItem>
                <TabItem Header="Site monitor"><StackPanel Margin="16">
                    <CheckBox x:Name="SiteHealthEnabledBox" Content="Automatically pause and resume trade for offline FTP/FTPS sites" Margin="0,0,0,16"/>
                    <TextBlock Text="Healthy site check interval (seconds)"/><TextBox x:Name="SiteHealthCheckBox" Margin="0,4,0,12"/>
                    <TextBlock Text="Offline site retry interval (seconds)"/><TextBox x:Name="SiteHealthRetryBox" Margin="0,4,0,12"/>
                    <TextBlock Text="Consecutive connection failures before pausing trade"/><TextBox x:Name="SiteHealthFailuresBox" Margin="0,4,0,12"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Text="Checks use NOOP and reuse idle connections when possible. Busy/full login slots and file errors do not mark a site offline. Running transfers continue; queued jobs wait and resume automatically when the site responds again."/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,12,0,0" Text="Login/TLS failures pause trade separately and wait at least 10 minutes before retrying. Saved site permissions and manual job pauses are retained. Open Tools > Site status for the current state or an immediate check."/>
                </StackPanel></TabItem>
                <TabItem Header="Site defaults"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Default username"/><TextBox x:Name="UsernameBox" Grid.Column="1" Margin="0,4"/><TextBlock Grid.Row="1" Text="Default protocol"/><ComboBox x:Name="ProtocolBox" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
                    <TextBlock Grid.Row="2" Text="Total slots"/><TextBox x:Name="SlotsBox" Grid.Row="2" Grid.Column="1" Margin="0,4"/><TextBlock Grid.Row="3" Text="Upload slots"/><TextBox x:Name="UploadsBox" Grid.Row="3" Grid.Column="1" Margin="0,4"/><TextBlock Grid.Row="4" Text="Download slots"/><TextBox x:Name="DownloadsBox" Grid.Row="4" Grid.Column="1" Margin="0,4"/><TextBlock Grid.Row="5" Text="Max idle time (seconds)"/><TextBox x:Name="DefaultIdleBox" Grid.Row="5" Grid.Column="1" Margin="0,4"/>
                </Grid></TabItem>
                <TabItem Header="Local"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Local download path"/><TextBox x:Name="LocalPathBox" Grid.Column="1" Margin="0,4"/><TextBlock Grid.Row="1" Text="Local download slots"/><TextBox x:Name="LocalDownloadsBox" Grid.Row="1" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,4"/><TextBlock Grid.Row="2" Text="Local upload slots"/><TextBox x:Name="LocalUploadsBox" Grid.Row="2" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,4"/>
                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
                        <TextBlock Text="Download temp folder (optional)" Margin="0,14,0,4"/>
                        <TextBox x:Name="DownloadTempBox" ToolTip="Local SSD or RAM disk. Empty downloads directly to the destination."/>
                        <TextBlock Text="Download here first, then copy the completed file to its destination. Needs room for the whole file. RAM-disk contents can disappear on restart." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,4"/>
                        <CheckBox x:Name="SerializeLocalBox" Content="One local transfer at a time (uploads, downloads and disk copies)" Margin="0,14,0,4"/>
                        <CheckBox x:Name="MinimizeToTrayBox" Content="Minimize and close FluxFTP to the system tray" Margin="0,8,0,4"/>
                    </StackPanel>
                </Grid></TabItem>
                <TabItem Header="FXP"><StackPanel Margin="16">
                    <TextBlock Text="Existing FXP target files" FontWeight="SemiBold"/>
                    <TextBlock Text="Target smaller" Margin="0,10,0,2"/><ComboBox x:Name="SmallerActionBox" Margin="0,2"/>
                    <TextBlock Text="Target same size" Margin="0,4,0,2"/><ComboBox x:Name="SameActionBox" Margin="0,2"/>
                    <TextBlock Text="Target larger" Margin="0,4,0,2"/><ComboBox x:Name="LargerActionBox" Margin="0,2"/>
                    <TextBlock Text="Applies to normal FXP and RACE files. Verified COMPLETE releases are still skipped. Resume uses REST on both servers for a smaller binary target; ASCII resume can be disabled in ASCII List. Zero-byte targets restart; Resume on a larger target uses Overwrite. Servers may reject writes due to dupe protection." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,12"/>
                    <CheckBox x:Name="ResumeOverwriteBox" Content="Auto overwrite file if resume is rejected" Margin="0,4,0,12" ToolTip="One restart from zero after a rejected REST command. Applies to upload, download and FXP/RACE. Does not apply to cancellation, timeout, dupe or file locks."/>
                    <TextBlock Text="FXP speed and progress" FontWeight="SemiBold"/>
                    <CheckBox x:Name="FxpSpeedMonitoringBox" Content="Estimate live FXP speed/progress and measure completed-file average" Margin="0,14,0,8"/>
                    <CheckBox x:Name="DownloadMeasurementBox" Content="Download measurement (diagnostic timing)" Margin="0,8,0,8"/>
                    <TextBlock Text="Off by default. Records per-file download timing in Connection Log and RACE log. Applies to new downloads." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12"/>
                    <TextBlock Text="Live estimates (≈) use site-pair speed history and destination directory sizes, smoothed between samples. Directory sampling runs at most once per second on an existing idle shared session; no extra logins are opened. Preallocated full-size files are ignored. Estimates never count as transferred bytes or prove completion. The measured final average remains bytes / successful transfer time. Applies to new binary direct FXP transfers." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel></TabItem>
                <TabItem Header="ASCII List"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <CheckBox x:Name="NoAsciiResumeBox" Content="Do not resume ASCII transfers" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="1" Text="Used when Always use binary file transfers is unchecked in Site Options. Wildcards are case-insensitive; prefix a regular expression with regex:." TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <ListBox x:Name="AsciiRulesList" Grid.Row="2" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="5,3"/>
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></Setter.Value></Setter>
                        </Style></ListBox.ItemContainerStyle>
                    </ListBox>
                    <WrapPanel Grid.Row="3" Margin="0,10,0,0"><Button Content="Add..." Click="AsciiAdd_Click" Margin="0,0,8,0"/><Button Content="Edit..." Click="AsciiEdit_Click" Margin="0,0,8,0"/><Button Content="Delete" Click="AsciiDelete_Click"/></WrapPanel>
                </Grid></TabItem>
                <TabItem Header="Skiplist"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <CheckBox x:Name="LogSkipMatchesBox" Content="Log skiplist matches (rule and file size)" Margin="0,4"/>
                        <CheckBox x:Name="SmartResumeBox" Content="Smart resume — wait for source growth on incoming updates" Margin="0,4"/>
                        <WrapPanel><TextBlock Text="Additional checks (1–3)" VerticalAlignment="Center"/><ComboBox x:Name="SmartResumeAttemptsBox" Width="60" Margin="8,2"/></WrapPanel>
                        <TextBlock Text="For RACE: when source is smaller than an existing target, defer Skip until incoming updates. Size equality is not proof of COMPLETE; target Skip/Resume/Overwrite policy still applies." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
                        <WrapPanel><CheckBox x:Name="EnableSkipListBox" Content="Enable Skip List" Margin="0,4,20,4"/><CheckBox x:Name="SkipZeroByteBox" Content="Skip Zero Byte File" Margin="0,4,20,4"/><CheckBox x:Name="SkipEmptyDirectoryBox" Content="Skip Empty Directory" Margin="0,4"/></WrapPanel>
                        <CheckBox x:Name="ApplySkipFoldersBox" Content="Apply Skip List to Folder" Margin="0,4"/>
                        <WrapPanel Margin="0,8"><TextBlock Text="Skip mode" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="SkipModeBox" Width="170"/><TextBlock Text="Skipped item color" VerticalAlignment="Center" Margin="15,0,10,0"/><TextBox x:Name="SkippedColorBox" Width="90"/><Button Content="Choose…" Click="SkippedColor_Click"/></WrapPanel>
                        <CheckBox x:Name="UseAdvancedSkipBox" Content="Use advanced filters instead of the normal skiplist" Checked="SkipFilterMode_Changed" Unchecked="SkipFilterMode_Changed" Margin="0,4"/>
                        <WrapPanel><Button Content="Advanced…" Click="AdvancedSkiplist_Click"/><Button Content="Import…" Click="ImportSkipList_Click"/><Button Content="Export…" Click="ExportSkipList_Click"/></WrapPanel>
                    </StackPanel>
                    <TextBox x:Name="SkipPatternsBox" Grid.Row="1" Margin="0,10" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource AppMonospaceFontFamily}"/>
                    <TextBlock x:Name="SkipFilterNotice" Grid.Row="2" Text="Normal mode: one wildcard per line. Selecting regex rules in Advanced disables the normal list. Only one filter mode is used at a time; both lists remain saved." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                </Grid></TabItem>
                <TabItem Header="Prio List"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Transfer category order — highest priority first" FontWeight="SemiBold"/>
                    <DockPanel Grid.Row="1" Margin="0,10">
                        <StackPanel DockPanel.Dock="Right" Margin="10,0,0,0">
                            <Button Content="Move up" Click="PriorityCategoryUp_Click"/>
                            <Button Content="Move down" Click="PriorityCategoryDown_Click"/>
                        </StackPanel>
                        <ListBox x:Name="PriorityCategoriesList" Height="140" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                    </DockPanel>
                    <TextBlock Grid.Row="2" Text="Sample and Proof are identified by folder name. Their contents stay in that category, including SFV and NFO files. Other files belong to Main files. Applies to uploads, downloads and FXP; running transfers finish normally." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Grid.Row="3" Text="Wildcard priority within each category" FontWeight="SemiBold"/>
                    <TextBox x:Name="PriorityPatternsBox" Grid.Row="4" Margin="0,10" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource AppMonospaceFontFamily}"/>
                    <TextBlock Grid.Row="5" Text="One wildcard per line; earlier matches go first within their category. Active imported site rules take precedence over these wildcards within the same category." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                </Grid></TabItem>
                <TabItem Header="Appearance"><StackPanel Margin="16">
                    <TextBlock Text="Status bar mode"/>
                    <ComboBox x:Name="LegendModeBox" Width="220" HorizontalAlignment="Left" SelectionChanged="LegendMode_Changed"/>
                    <TextBlock Text="Status bar font size" Margin="0,12,0,0"/>
                    <ComboBox x:Name="StatusFontBox" Width="220" HorizontalAlignment="Left"/>
                    <StackPanel x:Name="ScrollSpeedSettings" Visibility="Collapsed" Margin="0,12,0,0">
                        <TextBlock Text="Scroll speed (pixels per second)"/>
                        <ComboBox x:Name="ScrollSpeedBox" Width="220" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Text="One status line in every mode. Scrolling moves all status information across the full width. In other modes, drag the horizontal scrollbar if the information does not fit."/>
                </StackPanel></TabItem>
                <TabItem Header="Layout"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="LayoutPanel" Margin="16"/></ScrollViewer></TabItem>
                <TabItem Header="Themes">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="150"/><ColumnDefinition Width="145"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Theme name" VerticalAlignment="Center"/><TextBox x:Name="ThemeNameBox" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Text="Window" VerticalAlignment="Center"/><TextBox x:Name="ThemeWindowBox" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Surface" VerticalAlignment="Center"/><TextBox x:Name="ThemeSurfaceBox" Grid.Row="1" Grid.Column="3" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Text="Raised surface" VerticalAlignment="Center"/><TextBox x:Name="ThemeRaisedBox" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Border" VerticalAlignment="Center"/><TextBox x:Name="ThemeBorderBox" Grid.Row="2" Grid.Column="3" Margin="0,4"/>
                            <TextBlock Grid.Row="3" Text="Accent" VerticalAlignment="Center"/><TextBox x:Name="ThemeAccentBox" Grid.Row="3" Grid.Column="1" Margin="0,4"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Strong accent" VerticalAlignment="Center"/><TextBox x:Name="ThemeAccentStrongBox" Grid.Row="3" Grid.Column="3" Margin="0,4"/>
                            <TextBlock Grid.Row="4" Text="Text" VerticalAlignment="Center"/><TextBox x:Name="ThemeTextBox" Grid.Row="4" Grid.Column="1" Margin="0,4"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="Muted text" VerticalAlignment="Center"/><TextBox x:Name="ThemeMutedTextBox" Grid.Row="4" Grid.Column="3" Margin="0,4"/>
                            <TextBlock Grid.Row="5" Text="Selection" VerticalAlignment="Center"/><TextBox x:Name="ThemeSelectionBox" Grid.Row="5" Grid.Column="1" Margin="0,4"/>
                            <TextBlock Grid.Row="5" Grid.Column="2" Text="Hover" VerticalAlignment="Center"/><TextBox x:Name="ThemeHoverBox" Grid.Row="5" Grid.Column="3" Margin="0,4"/>
                            <TextBlock Grid.Row="6" Text="UI font" VerticalAlignment="Center"/><TextBox x:Name="ThemeFontBox" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4" ToolTip="For example Segoe UI"/>
                            <TextBlock Grid.Row="7" Text="Monospace font" VerticalAlignment="Center"/><TextBox x:Name="ThemeMonoFontBox" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" ToolTip="For example Cascadia Mono, Consolas"/>
                            <TextBlock Grid.Row="7" Grid.Column="3" Text="Size" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0"/><TextBox x:Name="ThemeFontSizeBox" Grid.Row="7" Grid.Column="3" Width="58" HorizontalAlignment="Right" Margin="0,4"/>
                            <TextBlock Grid.Row="8" Text="Resume progress" VerticalAlignment="Center"/><TextBox x:Name="ThemeResumeBox" Grid.Row="8" Grid.Column="1" Margin="0,4" ToolTip="Progress bar fill for transfers resumed from a nonzero offset."/>
                            <StackPanel Grid.Row="9" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Preview" Click="PreviewTheme_Click"/><Button Content="Reset default" Click="ResetTheme_Click"/><Button Content="Import…" Click="ImportTheme_Click"/><Button Content="Export…" Click="ExportTheme_Click"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Updates"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <CheckBox x:Name="CheckUpdatesBox" Content="Check for updates at startup" Margin="0,4,0,14"/>
                    <Button Grid.Row="1" Content="Check now" HorizontalAlignment="Left" Click="CheckUpdates_Click"/>
                    <TextBlock x:Name="UpdateStatusText" Grid.Row="2" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
                </Grid></TabItem>
                <TabItem Header="Proxy"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Proxy type"/><ComboBox x:Name="ProxyTypeBox" Grid.Column="1" Margin="0,4"/>
                    <TextBlock Grid.Row="1" Text="Host"/><TextBox x:Name="ProxyHostBox" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
                    <TextBlock Grid.Row="2" Text="Port"/><TextBox x:Name="ProxyPortBox" Grid.Row="2" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,4"/>
                    <TextBlock Grid.Row="3" Text="Username"/><TextBox x:Name="ProxyUsernameBox" Grid.Row="3" Grid.Column="1" Margin="0,4"/>
                    <TextBlock Grid.Row="4" Text="Password"/><PasswordBox x:Name="ProxyPasswordBox" Grid.Row="4" Grid.Column="1" Margin="0,4" Padding="8,5"/>
                    <CheckBox x:Name="ProxyDnsBox" Grid.Row="5" Grid.ColumnSpan="2" Content="Resolve destination hostnames through proxy" Margin="0,10,0,4"/>
                    <CheckBox x:Name="ProxyDataBox" Grid.Row="6" Grid.ColumnSpan="2" Content="Use proxy for PASV/EPSV data connections" Margin="0,4"/>
                    <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Text="Direct FXP data remains server-to-server. Active-mode incoming connections cannot be routed through this proxy."/>
                    <Button Grid.Row="8" Grid.Column="1" Content="Test proxy" HorizontalAlignment="Left" Margin="0,14,0,0" Click="TestProxy_Click"/>
                </Grid></TabItem>
                <TabItem Header="Backup/Import"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
                    <TextBlock Text="Full FluxFTP backup" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Text="Back up saved settings, sites and passwords, bookmarks, skip/priority rules, layout and themes, queue, statistics, RACE logs, site rules and linked VISIONARY files. Save settings changes before exporting."/>
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Text="Backups are encrypted with your password and can be imported on another PC. Keep the backup password: it is required for import."/>
                    <TextBlock Margin="0,14,0,4" Text="Backup password"/>
                    <PasswordBox x:Name="BackupPasswordBox" Padding="8,5"/>
                    <TextBlock Margin="0,8,0,4" Text="Confirm password (export only)"/>
                    <PasswordBox x:Name="BackupPasswordConfirmBox" Padding="8,5"/>
                    <WrapPanel Margin="0,14,0,0">
                        <Button x:Name="BackupExportButton" Content="Export backup…" Click="BackupExport_Click"/>
                        <Button x:Name="BackupImportButton" Content="Import backup…" Click="BackupImport_Click"/>
                        <Button x:Name="BackupCancelButton" Content="Cancel pending import" Click="BackupCancel_Click"/>
                    </WrapPanel>
                    <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Text="Import replaces the saved configuration at the next startup. Close FluxFTP completely and start it again. Your current configuration is saved in backup-restore-history first. Downloaded files are not included."/>
                    <TextBlock x:Name="BackupStatusText" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel></ScrollViewer></TabItem>
            </TabControl>
        </DockPanel>
    </DockPanel>
</Window>
