<UserControl x:Class="IoFtp.Desktop.MetricsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
 <DockPanel Margin="10">
  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
   
   <StackPanel>
    <StackPanel Orientation="Horizontal">
     <TextBlock Text="FLUXFTP METRICS" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
     <Button Content="⚙" ToolTip="Size and layout" Margin="12,0,0,0" Padding="6,2" Click="ToggleSizes_Click"/>
    </StackPanel>
    <TextBlock x:Name="UpdatedText" Foreground="{DynamicResource MutedTextBrush}"/>
   </StackPanel>
  </DockPanel>
  <ContentControl x:Name="SizeOptions" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,6" Foreground="{DynamicResource TextBrush}"/>
    <WrapPanel x:Name="CardsPanel" DockPanel.Dock="Top">
     <Border Style="{StaticResource MetricCard}" Width="195"><StackPanel><TextBlock Text="TRANSFERRED · SESSION" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="BytesText" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Border>
     <Border Style="{StaticResource MetricCard}" Width="165"><StackPanel><TextBlock Text="COMPLETED FILES" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="FilesText" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
     <Border Style="{StaticResource MetricCard}" Width="195"><StackPanel><TextBlock Text="FXP RATE · CURRENT" ToolTip="Completed FXP/relay bytes during the last 60 seconds divided by 60; updates on completion, not live throughput." Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="SpeedText" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
     <Border Style="{StaticResource MetricCard}" Width="195" ToolTip="Highest measured aggregate transfer rate in this session. Display-only estimates and temp-to-destination copies are excluded."><StackPanel><TextBlock Text="SESSION PEAK" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="SessionPeakText" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
     <Border Style="{StaticResource MetricCard}" Width="195" ToolTip="Highest measured aggregate transfer rate saved by FluxFTP across sessions. Display-only estimates and temp-to-destination copies are excluded."><StackPanel><TextBlock Text="ALL-TIME PEAK" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="AllTimePeakText" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Border>
     <Border Style="{StaticResource MetricCard}" Width="165"><StackPanel><TextBlock Text="QUEUED / ACTIVE" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="ActiveText" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
     <Border Style="{StaticResource MetricCard}" Width="165"><StackPanel><TextBlock Text="IDLE POOL" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="PoolText" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
     <Border Style="{StaticResource MetricCard}" Width="165" ToolTip="Most recent direct FXP attempt. STOR ends at the destination's initial reply; DATA ends at the transfer completion replies. A dash means that stage was not used or measured."><StackPanel><TextBlock Text="FXP TIMINGS · LATEST" Foreground="{DynamicResource MutedTextBrush}"/><Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock x:Name="PretText" Text="PRET —" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="CpsvText" Grid.Column="1" Text="CPSV —" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="StorText" Grid.Row="1" Text="STOR —" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="DataText" Grid.Row="1" Grid.Column="1" Text="DATA —" FontSize="12" FontWeight="SemiBold"/></Grid></StackPanel></Border>
     <Border Style="{StaticResource MetricCard}" Width="165"><StackPanel><TextBlock Text="SESSION RUNNING" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="UptimeText" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
     <WrapPanel VerticalAlignment="Center" Margin="8,0,0,5"><CheckBox x:Name="DebugBox" Content="Debug" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="8,0,10,0" ToolTip="Show full FTP error details and extra diagnostics. Bridge messages use Bridge-Info; 550 details appear here only with Debug enabled. Full diagnostics are retained in RACE-Log." Checked="Debug_Changed" Unchecked="Debug_Changed"/><Button x:Name="StatusButton" Content="Show Status" Click="Status_Click"/><Button Content="Hide Metrics" Click="Close_Click"/></WrapPanel>
    </WrapPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel x:Name="DashboardBody">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,10,0,0">
     <StackPanel>
      <DockPanel><TextBlock Text="TRAFFIC PER MINUTE" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock x:Name="ChartScaleText" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}"/></DockPanel>
      <Canvas x:Name="TrafficChart" Height="145" Margin="0,12,0,0" ClipToBounds="True" SizeChanged="Chart_SizeChanged"/>
      <DockPanel><TextBlock x:Name="ChartStartText" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="Latest →" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}"/></DockPanel>
      <TextBlock Text="Completed bytes per minute · latest 60 minutes of this session · FXP counted once. Not live network throughput." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0"/>
     </StackPanel>
    </Border>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" CornerRadius="3" Margin="0,10,0,10">
     <WrapPanel><TextBlock x:Name="SitesText" Margin="0,0,25,0"/><TextBlock x:Name="PoolDetailText" Margin="0,0,25,0"/><TextBlock x:Name="ProcessText"/></WrapPanel>
    </Border>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" CornerRadius="3" Margin="0,0,0,10"><StackPanel>
     <TextBlock Text="RACE ROUTES · CURRENT SESSION" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
     <TextBlock Text="Unique races received from Visi per section/release/source/destination. Repeated chains counted once; not race wins." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,6"/>
     <TextBlock x:Name="RaceRoutesEmpty" Text="Waiting for Visi chains…"/>
     <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="RaceRoutesList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Margin="0,4,24,4" Foreground="{DynamicResource TextBrush}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    </StackPanel></Border>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" CornerRadius="3" Margin="0,0,0,10"><StackPanel>
     <TextBlock Text="CONFIRMED RACE WINS · BY DESTINATION" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
     <TextBlock Text="First place for your account, reported by mapped IRC bots. A completed transfer is not a win. Requires a COMPLETE message followed by the final [1] user ranking; see bridge guide." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,6"/>
     <TextBlock x:Name="RaceWinsEmpty" Text="No confirmed results received yet — results are unknown, not losses." TextWrapping="Wrap"/>
     <ItemsControl x:Name="RaceWinsList"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Margin="0,4,0,0" Foreground="{DynamicResource TextBrush}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Expander Header="Race account names per site" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0"><StackPanel><TextBlock Text="Defaults to the saved FTP username. Change if the bot ranking uses another name. One SITE=nickname per line." TextWrapping="Wrap"/><TextBox x:Name="RaceIdentitiesText" AcceptsReturn="True" Height="110" VerticalScrollBarVisibility="Auto"/><Button Content="Save account names" Click="SaveRaceIdentities_Click" HorizontalAlignment="Left"/><TextBlock x:Name="RaceIdentityStatus" TextWrapping="Wrap"/></StackPanel></Expander>
    </StackPanel></Border>
    <Expander Header="Server stats · user info" IsExpanded="False" Margin="0,0,0,8" Foreground="{DynamicResource TextBrush}" ToolTip="Latest user info with SITE STATS fallback. Refresh uses existing idle server sessions only.">
     <StackPanel><WrapPanel><Button x:Name="StatsRefreshButton" Content="Update server stats" Click="RefreshStats_Click"/><TextBlock x:Name="StatsStatusText" Text="Uses existing idle sessions." Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/></WrapPanel>
     <TextBlock x:Name="ServerStatsEmpty" Text="No server statistics received yet. Connect/use a site, then update." Margin="0,8,0,4" TextWrapping="Wrap"/>
     <ScrollViewer x:Name="ServerStatsScroll" MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
      <ItemsControl x:Name="ServerStatsList"><ItemsControl.ItemTemplate><DataTemplate>
       <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,4,0,4"><StackPanel>
        <TextBlock Text="{Binding Header}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock Text="{Binding Report}" FontFamily="Consolas" Foreground="{DynamicResource TextBrush}"/>
       </StackPanel></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </ScrollViewer>
    </StackPanel></Expander>
    <Expander Header="Detailed statistics · session and all-time" IsExpanded="False" Foreground="{DynamicResource TextBrush}">
     <ListView x:Name="MetricsList" Height="280"><ListView.View><GridView><GridViewColumn Header="METRIC" DisplayMemberBinding="{Binding Name}" Width="240"/><GridViewColumn Header="VALUE" DisplayMemberBinding="{Binding Value}" Width="175"/><GridViewColumn Header="DETAIL" DisplayMemberBinding="{Binding Detail}" Width="560"/></GridView></ListView.View></ListView>
    </Expander>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</UserControl>


